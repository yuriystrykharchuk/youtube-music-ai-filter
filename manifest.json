{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "short_name": "YTM AI Filter",
  "description": "__MSG_extDescription__",
  "version": "1.0.0",
  "default_locale": "en",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage"],
  "host_permissions": ["https://music.youtube.com/*"],
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "YTM AI Filter",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "options_ui": {
    "page": "src/options/options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": ["https://music.youtube.com/*"],
      "js": ["src/shared/detect.js", "src/content/inject.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://music.youtube.com/*"],
      "js": ["src/shared/detect.js", "src/shared/settings.js", "src/content/content.js"],
      "run_at": "document_idle"
    }
  ]
}
